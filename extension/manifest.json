{
  "manifest_version": 3,
  "name": "renga",
  "version": "0.2.0",
  "description": "one renga team's chat beside whatever you're doing. reads meet captions and your tabs, but only for teams that have an agent for it.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8020/*",
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "open renga"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "captions.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
