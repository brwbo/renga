# copy to .env (gitignored, never committed), fill in, then load the key into
# modal as a secret the design teams' sandboxes can use:
#
#   .venv/bin/modal secret create gemini --from-dotenv .env
#
# the agents read the key from modal, not from this file.

# gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# or claude, as a secret called anthropic:
#   .venv/bin/modal secret create anthropic --from-dotenv .env
# ANTHROPIC_API_KEY=
